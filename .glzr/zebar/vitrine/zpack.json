{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "vitrine",
  "version": "0.1.0",
  "description": "Minimal translucent GlazeWM topbar with inline workspace renaming.",
  "tags": [
    "topbar"
  ],
  "previewImages": [],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "with-glazewm",
      "htmlPath": "./with-glazewm.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": true,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "*.ps1"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": "^(\\-NoProfile|\\-ExecutionPolicy|Bypass|\\-Command|& \\(Join\\-Path \\$env:USERPROFILE '\\.glzr\\\\zebar\\\\vitrine\\\\bluetooth\\.ps1'\\)|\\-NoProfile\\ \\-ExecutionPolicy\\ Bypass\\ \\-Command\\ & \\(Join\\-Path \\$env:USERPROFILE '\\.glzr\\\\zebar\\\\vitrine\\\\bluetooth\\.ps1'\\))$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
